# Optional Telegram notifications. Leave empty to disable them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner limits
SCAN_TIMEOUT=10
SCAN_CONCURRENCY=50

# Certificate expiry notification thresholds in days
NOTIFY_THRESHOLDS=60,30,14,7,1

# Risk status boundaries in days
THRESHOLD_OK=60
THRESHOLD_INFO=30
THRESHOLD_WARNING=14

# Database path (relative to the backend working directory)
RADAR_DATABASE_PATH=data/certificates.sqlite3

# Allowed frontend origin(s), comma-separated
FRONTEND_ORIGINS=http://localhost:3000
